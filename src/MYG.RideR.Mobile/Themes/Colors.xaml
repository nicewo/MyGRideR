<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="AppBackground">#080B10</Color>
    <Color x:Key="Surface">#101720</Color>
    <Color x:Key="SurfaceAlt">#16202B</Color>
    <Color x:Key="SurfaceElevated">#1C2733</Color>
    <Color x:Key="StrokeSubtle">#263443</Color>
    <Color x:Key="TextPrimary">#F4F7FA</Color>
    <Color x:Key="TextSecondary">#AAB7C4</Color>
    <Color x:Key="TextMuted">#6F7D8A</Color>
    <Color x:Key="Accent">#35D0A6</Color>
    <Color x:Key="AccentAlt">#4EA5FF</Color>
    <Color x:Key="Warning">#F4B860</Color>
    <Color x:Key="Danger">#F36B7F</Color>
    <Color x:Key="TransparentColor">#00000000</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackground}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAlt}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevated}" />
    <SolidColorBrush x:Key="StrokeSubtleBrush" Color="{StaticResource StrokeSubtle}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="AccentAltBrush" Color="{StaticResource AccentAlt}" />
</ResourceDictionary>
