<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MYG.RideR.Mobile.Views.TripsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MYG.RideR.Mobile.ViewModels"
    x:DataType="vm:TripsViewModel"
    Title="Trips">
    <Grid Padding="{StaticResource PagePadding}" RowDefinitions="Auto,*" RowSpacing="{StaticResource SpaceMd}">
        <Label Style="{StaticResource PageTitleLabel}" Text="Trips" />
        <CollectionView Grid.Row="1" ItemsSource="{Binding Trips}">
            <CollectionView.EmptyView>
                <Label Style="{StaticResource CaptionLabel}" Text="No trips yet." />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:TripListItem">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                        <VerticalStackLayout>
                            <Label Text="{Binding Title}" />
                            <Label Style="{StaticResource CaptionLabel}" Text="{Binding Details}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
