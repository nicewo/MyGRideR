<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MYG.RideR.Mobile.Views.TripsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Trips">
    <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SpaceMd}">
        <Label Style="{StaticResource PageTitleLabel}" Text="Trips" />
        <Border Style="{StaticResource CardStyle}">
            <Label Style="{StaticResource CaptionLabel}" Text="Trip history surface reserved." />
        </Border>
    </VerticalStackLayout>
</ContentPage>
