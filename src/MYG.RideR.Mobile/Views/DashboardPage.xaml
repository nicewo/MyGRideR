<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MYG.RideR.Mobile.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MYG.RideR.Mobile.Controls"
    xmlns:viewModels="clr-namespace:MYG.RideR.Mobile.ViewModels"
    x:DataType="viewModels:DashboardViewModel"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="56,*,Auto">

        <controls:TopStatusBar
            Grid.Row="0"
            GpsQualityColor="{Binding GpsQualityColor}"
            GpsSummaryText="{Binding GpsSummaryText}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="12,0" Spacing="10">

                <!--  Saat + Pusula  -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border
                        Padding="14,10"
                        BackgroundColor="{StaticResource PanelBackground}"
                        Stroke="{StaticResource PanelStroke}"
                        StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout>
                            <Label
                                FontAttributes="Bold"
                                FontSize="40"
                                Text="{Binding ClockShort}"
                                TextColor="White" />
                            <Label
                                FontSize="12"
                                Text="{Binding DateText}"
                                TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="14,10"
                        BackgroundColor="{StaticResource PanelBackground}"
                        Stroke="{StaticResource PanelStroke}"
                        StrokeShape="RoundRectangle 14">
                        <Grid ColumnDefinitions="*,*">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label
                                    FontSize="20"
                                    Text="🧭"
                                    TextColor="{StaticResource Alert}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    Text="{Binding HeadingText}"
                                    TextColor="White" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="20"
                                    Text="{Binding SatelliteText}"
                                    TextColor="{StaticResource Success}" />
                                <Label
                                    FontSize="10"
                                    Text="UYDU"
                                    TextColor="{StaticResource NeonBlue}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>

                <!--  Gösterge  -->
                <controls:SpeedGauge
                    Margin="0,8,0,0"
                    HeightRequest="340"
                    HorizontalOptions="Center"
                    SpeedKmh="{Binding SpeedKmh}"
                    WidthRequest="340" />

                <!--  2x2 sürüş istatistiği  -->
                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="10"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="10">
                    <VerticalStackLayout>
                        <Label
                            FontAttributes="Bold"
                            FontSize="28"
                            Text="{Binding TripTime}"
                            TextColor="{StaticResource TextPrimary}" />
                        <Label Style="{StaticResource CaptionLabel}" Text="Süre" />
                        <Label
                            FontSize="11"
                            Text="{Binding StopTime, StringFormat='Duruş {0}'}"
                            TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1">
                        <Label
                            FontAttributes="Bold"
                            FontSize="28"
                            Text="{Binding DistanceKm, StringFormat='{0:F2} km'}"
                            TextColor="{StaticResource TextPrimary}" />
                        <Label Style="{StaticResource CaptionLabel}" Text="Mesafe" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="1">
                        <Label
                            FontAttributes="Bold"
                            FontSize="28"
                            Text="{Binding AverageSpeedKmh, StringFormat='{0} km/h'}"
                            TextColor="{StaticResource TextPrimary}" />
                        <Label Style="{StaticResource CaptionLabel}" Text="Ort. hız" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                        <Label
                            FontAttributes="Bold"
                            FontSize="28"
                            Text="{Binding MaximumSpeedKmh, StringFormat='{0} km/h'}"
                            TextColor="{StaticResource TextPrimary}" />
                        <Label Style="{StaticResource CaptionLabel}" Text="Azami hız" />
                    </VerticalStackLayout>
                </Grid>

                <!--  Kilometre sayacı  -->
                <HorizontalStackLayout Spacing="8">
                    <Label
                        FontSize="12"
                        Text="Kilometre sayacı"
                        TextColor="{StaticResource TextSecondary}"
                        VerticalOptions="Center" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="14"
                        Text="{Binding OdometerText, StringFormat='{0} km'}"
                        TextColor="{StaticResource TextPrimary}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!--  GPS durumu  -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Border
                        Grid.Column="1"
                        Padding="12,6"
                        BackgroundColor="{StaticResource PanelBackground}"
                        Stroke="{StaticResource Success}"
                        StrokeShape="RoundRectangle 14">
                        <Label
                            FontAttributes="Bold"
                            FontSize="11"
                            Text="{Binding GpsStatus}"
                            TextColor="{StaticResource Success}" />
                    </Border>
                </Grid>

                <!--  Harita  -->
                <controls:MapPanel x:Name="MapView" HeightRequest="260" />

                <!--  Rakım + yön  -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Label
                        FontSize="14"
                        Text="{Binding AltitudeM, StringFormat='Rakım {0} m'}"
                        TextColor="{StaticResource TextSecondary}" />
                    <Label
                        Grid.Column="1"
                        FontSize="14"
                        HorizontalTextAlignment="End"
                        Text="{Binding HeadingText, StringFormat='Yön {0}'}"
                        TextColor="{StaticResource TextSecondary}" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomToolbar Grid.Row="2" />

    </Grid>

</ContentPage>
