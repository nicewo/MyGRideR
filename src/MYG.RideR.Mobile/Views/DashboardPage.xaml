<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MYG.RideR.Mobile.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MYG.RideR.Mobile.Controls"
    xmlns:viewModels="clr-namespace:MYG.RideR.Mobile.ViewModels"
    x:DataType="viewModels:DashboardViewModel"
    BackgroundColor="#05070B"
    Shell.NavBarIsVisible="False">

    <Grid>

        <!--  Ana Satırlar  -->
        <Grid.RowDefinitions>

            <RowDefinition Height="70" />

            <RowDefinition Height="330" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />

            <RowDefinition Height="80" />

        </Grid.RowDefinitions>

        <!--  Üst Bar  -->
        <controls:TopStatusBar Grid.Row="0" />

        <!--  Büyük Hız Göstergesi  -->
        <Grid Grid.Row="1">

            <controls:SpeedGauge HorizontalOptions="Center" VerticalOptions="Center" />

        </Grid>
        <!--  İstatistikler  -->

        <Grid
            Grid.Row="2"
            Margin="18,8"
            ColumnDefinitions="*,*"
            ColumnSpacing="10"
            RowDefinitions="Auto,Auto"
            RowSpacing="10">

            <controls:StatCard
                Title="MESAFE"
                Unit="km"
                Value="{Binding DistanceKm}" />

            <controls:StatCard
                Title="ORT."
                Grid.Column="1"
                Unit="km/h"
                Value="{Binding AverageSpeedKmh}" />

            <controls:StatCard
                Title="MAX"
                Grid.Row="1"
                Unit="km/h"
                Value="{Binding MaximumSpeedKmh}" />

            <controls:StatCard
                Title="SÜRE"
                Grid.Row="1"
                Grid.Column="1"
                Value="{Binding TripTime}" />

        </Grid>

        <!--  Harita  -->

        <controls:MapPanel Grid.Row="3" Margin="18,12,18,12" />

        <!--  Alt Menü  -->

        <controls:BottomToolbar Grid.Row="4" />

    </Grid>

</ContentPage>
