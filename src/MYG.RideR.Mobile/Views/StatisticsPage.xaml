<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MYG.RideR.Mobile.Views.StatisticsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MYG.RideR.Mobile.ViewModels"
    x:DataType="vm:StatisticsViewModel"
    Title="Statistics">
    <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SpaceMd}">
        <Label Style="{StaticResource PageTitleLabel}" Text="Statistics" />
        <Border Style="{StaticResource CardStyle}">
            <VerticalStackLayout Spacing="6">
                <Label Text="{Binding TripCountText, StringFormat='Trips: {0}'}" />
                <Label Text="{Binding TotalDistanceText, StringFormat='Distance: {0}'}" />
                <Label Text="{Binding TotalDurationText, StringFormat='Time: {0}'}" />
                <Label Text="{Binding AverageSpeedText, StringFormat='Average: {0}'}" />
                <Label Text="{Binding MaximumSpeedText, StringFormat='Max: {0}'}" />
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>
