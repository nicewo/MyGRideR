<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MYG.RideR.Mobile.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Ayarlar">
    <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SpaceMd}">
        <Label Style="{StaticResource PageTitleLabel}" Text="Ayarlar" />
        <Border Style="{StaticResource CardStyle}">
            <VerticalStackLayout Spacing="{StaticResource SpaceMd}" HorizontalOptions="Center">
                <Image Source="mygrider_logo.png" WidthRequest="180" HeightRequest="180" Aspect="AspectFit" HorizontalOptions="Center" />
                <Label Style="{StaticResource CaptionLabel}" Text="{Binding AppVersionText}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>
        <Border Style="{StaticResource CardStyle}">
            <VerticalStackLayout Spacing="{StaticResource SpaceMd}">
                <Label Style="{StaticResource CaptionLabel}" Text="Araç modu (gösterge ölçeği)" />
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                    <Button Grid.Column="0" Text="Yaya" Command="{Binding SetVehicleModeCommand}" CommandParameter="0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsWalk}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource NeonBlue}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1" Text="Bisiklet" Command="{Binding SetVehicleModeCommand}" CommandParameter="1">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsBicycle}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource NeonBlue}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="2" Text="Motor" Command="{Binding SetVehicleModeCommand}" CommandParameter="2">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsMotorcycle}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource NeonBlue}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="3" Text="Araba" Command="{Binding SetVehicleModeCommand}" CommandParameter="3">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsCar}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource NeonBlue}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </VerticalStackLayout>
        </Border>
        <Border Style="{StaticResource CardStyle}">
            <VerticalStackLayout Spacing="{StaticResource SpaceMd}">
                <Label Style="{StaticResource CaptionLabel}" Text="{Binding CrashLogStatus}" />
                <Entry
                    Keyboard="Email"
                    Placeholder="Rapor e-posta adresi"
                    Text="{Binding ReportEmail}"
                    TextColor="{StaticResource TextPrimary}"
                    PlaceholderColor="{StaticResource TextMuted}" />
                <HorizontalStackLayout Spacing="{StaticResource SpaceMd}">
                    <Button Command="{Binding SendReportCommand}" Text="Hata raporla" />
                    <Button Command="{Binding ShareCrashLogCommand}" Text="Paylaş" />
                    <Button Command="{Binding ClearCrashLogCommand}" Text="Temizle" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>
