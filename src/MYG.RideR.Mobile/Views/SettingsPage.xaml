<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MYG.RideR.Mobile.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Ayarlar">
    <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SpaceMd}">
        <Label Style="{StaticResource PageTitleLabel}" Text="Ayarlar" />
        <Border Style="{StaticResource CardStyle}">
            <VerticalStackLayout Spacing="{StaticResource SpaceMd}" HorizontalOptions="Center">
                <Image Source="mygrider_logo.png" WidthRequest="180" HeightRequest="180" Aspect="AspectFit" HorizontalOptions="Center" />
                <Label Style="{StaticResource CaptionLabel}" Text="{Binding AppVersionText}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>
        <Border Style="{StaticResource CardStyle}">
            <VerticalStackLayout Spacing="{StaticResource SpaceMd}">
                <Label Style="{StaticResource CaptionLabel}" Text="{Binding CrashLogStatus}" />
                <HorizontalStackLayout Spacing="{StaticResource SpaceMd}">
                    <Button Command="{Binding ShareCrashLogCommand}" Text="Paylaş" />
                    <Button Command="{Binding ClearCrashLogCommand}" Text="Temizle" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>
