<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="MYG.RideR.Mobile.Controls.MapPanel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui">

    <Border
        Margin="0"
        Padding="0"
        BackgroundColor="{StaticResource PanelBackground}"
        Stroke="{StaticResource PanelStroke}"
        StrokeShape="RoundRectangle 22"
        StrokeThickness="1">

        <Grid>

            <mapsui:MapControl x:Name="Map" BackgroundColor="{StaticResource MapBackground}" />

            <Label
                Margin="6,0,6,4"
                FontSize="10"
                HorizontalOptions="Start"
                Text="© OpenStreetMap contributors"
                TextColor="{StaticResource TextMutedAlt}"
                VerticalOptions="End" />

            <!--  Üst Bilgi  -->

            <Border
                Margin="12"
                Padding="12,8"
                BackgroundColor="{StaticResource PanelOverlay}"
                HorizontalOptions="Start"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="0"
                VerticalOptions="Start">

                <HorizontalStackLayout Spacing="8">

                    <Ellipse
                        Fill="{StaticResource Success}"
                        HeightRequest="10"
                        WidthRequest="10" />

                    <Label
                        FontSize="13"
                        Text="GPS Aktif"
                        TextColor="White" />

                </HorizontalStackLayout>

            </Border>

            <!--  Sağ Alt Konum  -->

            <Border
                Margin="12"
                Padding="12,8"
                BackgroundColor="{StaticResource PanelOverlay}"
                HorizontalOptions="End"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="0"
                VerticalOptions="End">

                <Label
                    FontSize="12"
                    Text="Konum Bekleniyor..."
                    TextColor="{StaticResource TextSecondaryAlt}" />

            </Border>

        </Grid>

    </Border>

</ContentView>
