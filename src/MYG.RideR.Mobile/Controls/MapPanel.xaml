<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="MYG.RideR.Mobile.Controls.MapPanel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui">

    <Border
        Margin="0"
        Padding="0"
        BackgroundColor="{StaticResource PanelBackground}"
        Stroke="{StaticResource PanelStroke}"
        StrokeShape="RoundRectangle 22"
        StrokeThickness="1">

        <Grid>

            <mapsui:MapControl x:Name="Map" BackgroundColor="{StaticResource MapBackground}" />

            <!--  Üst Bilgi  -->

            

            <!--  Sol Alt Koordinat Çipi  -->

            <Border
                Margin="12"
                Padding="10,6"
                BackgroundColor="{StaticResource PanelOverlay}"
                HorizontalOptions="Start"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="0"
                VerticalOptions="End">

                <Label
                    x:Name="CoordinateLabel"
                    FontSize="11"
                    Text="--"
                    TextColor="White" />

            </Border>

            <!--  Sağ Alt Konum  -->

            <VerticalStackLayout
                Margin="12"
                HorizontalOptions="End"
                Spacing="8"
                VerticalOptions="End">

                <Button
                    BackgroundColor="{StaticResource PanelOverlay}"
                    Clicked="LocateClicked"
                    CornerRadius="22"
                    FontSize="18"
                    HeightRequest="44"
                    Padding="0"
                    Text="◎"
                    TextColor="{StaticResource NeonBlue}"
                    WidthRequest="44" />

                <Button
                    BackgroundColor="{StaticResource PanelOverlay}"
                    Clicked="LayersClicked"
                    CornerRadius="22"
                    FontSize="18"
                    HeightRequest="44"
                    Padding="0"
                    Text="⧉"
                    TextColor="{StaticResource NeonBlue}"
                    WidthRequest="44" />

            </VerticalStackLayout>

        </Grid>

    </Border>

</ContentView>
