<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="MYG.RideR.Mobile.Controls.BottomToolbar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border
        Margin="12,0,12,10"
        Padding="6,4"
        BackgroundColor="{StaticResource PanelBackground}"
        Stroke="{StaticResource PanelStroke}"
        StrokeShape="RoundRectangle 24"
        StrokeThickness="1">

        <Grid ColumnDefinitions="*,*,1.3*,*,*">

            <Button
                BackgroundColor="Transparent"
                Clicked="RouteClicked"
                ContentLayout="Top,2"
                FontSize="11"
                Text="Rota"
                TextColor="White" />

            <Button
                Grid.Column="1"
                BackgroundColor="Transparent"
                Clicked="PhotoClicked"
                FontSize="11"
                Text="Fotoğraf Ekle"
                TextColor="White" />

            <Button
                Grid.Column="2"
                BackgroundColor="{StaticResource Alert}"
                Command="{Binding ToggleRecordingCommand}"
                CornerRadius="32"
                FontAttributes="Bold"
                FontSize="14"
                HeightRequest="64"
                LineBreakMode="NoWrap"
                Text="{Binding RecordButtonText}"
                TextColor="White"
                WidthRequest="64" />

            <Button
                Grid.Column="3"
                BackgroundColor="Transparent"
                Clicked="AlertClicked"
                FontSize="11"
                Text="Sesli Uyarı"
                TextColor="White" />

            <Button
                Grid.Column="4"
                BackgroundColor="Transparent"
                Clicked="SettingsClicked"
                FontSize="11"
                Text="Ayarlar"
                TextColor="White" />

        </Grid>

    </Border>

</ContentView>
