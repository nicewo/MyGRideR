<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="MYG.RideR.Mobile.Controls.BottomToolbar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border
        Margin="16,0,16,16"
        Padding="12"
        BackgroundColor="#11161E"
        Stroke="#1E2732"
        StrokeShape="RoundRectangle 24"
        StrokeThickness="1">

        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">

            <!--  Dashboard  -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="4">

                <Label
                    FontSize="22"
                    HorizontalOptions="Center"
                    Text="🏠"
                    TextColor="#00BFFF" />

                <Label
                    FontSize="11"
                    HorizontalOptions="Center"
                    Text="Dashboard"
                    TextColor="White" />

            </VerticalStackLayout>

            <!--  Sürüşler  -->
            <VerticalStackLayout
                Grid.Column="1"
                HorizontalOptions="Center"
                Spacing="4">

                <Label
                    FontSize="22"
                    HorizontalOptions="Center"
                    Text="🛣️"
                    TextColor="#A5B4C3" />

                <Label
                    FontSize="11"
                    HorizontalOptions="Center"
                    Text="Trips"
                    TextColor="#A5B4C3" />

            </VerticalStackLayout>

            <!--  İstatistik  -->
            <VerticalStackLayout
                Grid.Column="2"
                HorizontalOptions="Center"
                Spacing="4">

                <Label
                    FontSize="22"
                    HorizontalOptions="Center"
                    Text="📊"
                    TextColor="#A5B4C3" />

                <Label
                    FontSize="11"
                    HorizontalOptions="Center"
                    Text="Stats"
                    TextColor="#A5B4C3" />

            </VerticalStackLayout>

            <!--  Ayarlar  -->
            <VerticalStackLayout
                Grid.Column="3"
                HorizontalOptions="Center"
                Spacing="4">

                <Label
                    FontSize="22"
                    HorizontalOptions="Center"
                    Text="⚙️"
                    TextColor="#A5B4C3" />

                <Label
                    FontSize="11"
                    HorizontalOptions="Center"
                    Text="Settings"
                    TextColor="#A5B4C3" />

            </VerticalStackLayout>

        </Grid>

    </Border>

</ContentView>
