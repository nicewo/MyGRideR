<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="MYG.RideR.Mobile.Controls.BottomToolbar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border
        Margin="16,0,16,16"
        Padding="12"
        BackgroundColor="#11161E"
        Stroke="#1E2732"
        StrokeShape="RoundRectangle 24"
        StrokeThickness="1">

        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">

            <!--  Dashboard  -->
            <Border
                Grid.Column="0"
                BackgroundColor="Transparent"
                StrokeThickness="0">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="DashboardTapped" />
                </Border.GestureRecognizers>

                <VerticalStackLayout HorizontalOptions="Center" Spacing="4">

                    <Label
                        FontSize="22"
                        HorizontalOptions="Center"
                        Text="🏠"
                        TextColor="#00BFFF" />

                    <Label
                        FontSize="11"
                        HorizontalOptions="Center"
                        Text="Dashboard"
                        TextColor="White" />

                </VerticalStackLayout>

            </Border>

            <!--  Sürüşler  -->
            <Border
                Grid.Column="1"
                BackgroundColor="Transparent"
                StrokeThickness="0">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TripsTapped" />
                </Border.GestureRecognizers>

                <VerticalStackLayout HorizontalOptions="Center" Spacing="4">

                    <Label
                        FontSize="22"
                        HorizontalOptions="Center"
                        Text="🛣️"
                        TextColor="#00BFFF" />

                    <Label
                        FontSize="11"
                        HorizontalOptions="Center"
                        Text="Trips"
                        TextColor="White" />

                </VerticalStackLayout>

            </Border>

            <!--  İstatistik  -->
            <Border
                Grid.Column="2"
                BackgroundColor="Transparent"
                StrokeThickness="0">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="StatisticsTapped" />
                </Border.GestureRecognizers>

                <VerticalStackLayout HorizontalOptions="Center" Spacing="4">

                    <Label
                        FontSize="22"
                        HorizontalOptions="Center"
                        Text="📊"
                        TextColor="#00BFFF" />

                    <Label
                        FontSize="11"
                        HorizontalOptions="Center"
                        Text="Statistics"
                        TextColor="White" />

                </VerticalStackLayout>

            </Border>

            <!--  Ayarlar  -->
            <Border
                Grid.Column="3"
                BackgroundColor="Transparent"
                StrokeThickness="0">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="SettingsTapped" />
                </Border.GestureRecognizers>

                <VerticalStackLayout HorizontalOptions="Center" Spacing="4">

                    <Label
                        FontSize="22"
                        HorizontalOptions="Center"
                        Text="⚙️"
                        TextColor="#00BFFF" />

                    <Label
                        FontSize="11"
                        HorizontalOptions="Center"
                        Text="Settings"
                        TextColor="White" />

                </VerticalStackLayout>

            </Border>

        </Grid>

    </Border>

</ContentView>
