<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="MYG.RideR.Mobile.Controls.TopStatusBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10" Padding="4,0">

        <Button
            BackgroundColor="Transparent"
            Clicked="OnMenuClicked"
            FontSize="22"
            Padding="8,0"
            Text="☰"
            TextColor="White" />

        <Label
            Grid.Column="1"
            FontSize="22"
            Text="🏍"
            TextColor="{StaticResource NeonBlue}"
            VerticalOptions="Center" />

        <Border
            Grid.Column="2"
            Padding="14,6"
            BackgroundColor="{StaticResource PanelBackground}"
            HorizontalOptions="Center"
            Stroke="{StaticResource PanelStroke}"
            StrokeShape="RoundRectangle 16"
            StrokeThickness="1"
            VerticalOptions="Center">
            <HorizontalStackLayout Spacing="8">
                <Ellipse
                    Fill="{StaticResource Success}"
                    HeightRequest="9"
                    VerticalOptions="Center"
                    WidthRequest="9" />
                <Label
                    FontAttributes="Bold"
                    FontSize="13"
                    Text="GPS"
                    TextColor="White"
                    VerticalOptions="Center" />
                <Label
                    FontSize="13"
                    Text="📶"
                    TextColor="{StaticResource Success}"
                    VerticalOptions="Center" />
                <Label
                    FontSize="12"
                    Text="{Binding AccuracyText, Source={x:Reference Root}}"
                    TextColor="{StaticResource TextSecondary}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <HorizontalStackLayout Grid.Column="3" Spacing="4" VerticalOptions="Center">
            <Label
                FontSize="16"
                Text="🔋"
                VerticalOptions="Center" />
            <Label
                x:Name="BatteryLabel"
                FontAttributes="Bold"
                FontSize="13"
                Text="%--"
                TextColor="White"
                VerticalOptions="Center" />
        </HorizontalStackLayout>

    </Grid>

</ContentView>
