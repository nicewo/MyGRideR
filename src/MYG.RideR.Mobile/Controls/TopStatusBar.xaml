<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="MYG.RideR.Mobile.Controls.TopStatusBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border
        Margin="16,12,16,0"
        Padding="16,10"
        BackgroundColor="#11161E"
        Stroke="#1F2935"
        StrokeShape="RoundRectangle 20"
        StrokeThickness="1">

        <Grid
            ColumnDefinitions="50,*,Auto,Auto"
            ColumnSpacing="12"
            VerticalOptions="Center">

            <!--  Menü  -->

            <Border
                BackgroundColor="#1B2430"
                HeightRequest="42"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="0"
                WidthRequest="42">

                <Label
                    FontSize="20"
                    HorizontalOptions="Center"
                    Text="☰"
                    TextColor="White"
                    VerticalOptions="Center" />

            </Border>

            <!--  GPS  -->

            <HorizontalStackLayout
                Grid.Column="1"
                Spacing="8"
                VerticalOptions="Center">

                <Ellipse
                    Fill="#00D26A"
                    HeightRequest="10"
                    WidthRequest="10" />

                <Label
                    FontSize="14"
                    Text="{Binding GpsStatus}"
                    TextColor="White" />

                <Label
                    FontSize="13"
                    Text="±3 m"
                    TextColor="#8FA6C2" />

            </HorizontalStackLayout>

            <!--  Saat  -->

            <Label
                Grid.Column="2"
                FontAttributes="Bold"
                FontSize="22"
                Text="{Binding Clock}"
                TextColor="White"
                VerticalOptions="Center" />

            <!--  Profil  -->

            <Border
                Grid.Column="3"
                BackgroundColor="#2A3240"
                HeightRequest="42"
                StrokeShape="RoundRectangle 21"
                StrokeThickness="0"
                WidthRequest="42">

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    HorizontalOptions="Center"
                    Text="M"
                    TextColor="#00BFFF"
                    VerticalOptions="Center" />

            </Border>

        </Grid>

    </Border>

</ContentView>
