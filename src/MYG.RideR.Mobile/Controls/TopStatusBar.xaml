<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="MYG.RideR.Mobile.Controls.TopStatusBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10" Padding="4,0">

        <Button
            BackgroundColor="Transparent"
            Clicked="OnMenuClicked"
            FontSize="22"
            Padding="8,0"
            Text="☰"
            TextColor="White" />

        <Image
            Grid.Column="1"
            HeightRequest="32"
            Source="mygrider_logo.png"
            VerticalOptions="Center"
            WidthRequest="32" />

        <Border
            Grid.Column="2"
            Padding="14,6"
            BackgroundColor="{StaticResource PanelBackground}"
            HorizontalOptions="Center"
            Stroke="{Binding GpsQualityColor, Source={x:Reference Root}}"
            StrokeShape="RoundRectangle 16"
            StrokeThickness="1"
            VerticalOptions="Center">
            <Label
                FontAttributes="Bold"
                FontSize="12"
                LineBreakMode="NoWrap"
                Text="{Binding GpsSummaryText, Source={x:Reference Root}}"
                TextColor="{Binding GpsQualityColor, Source={x:Reference Root}}"
                VerticalOptions="Center" />
        </Border>

        <HorizontalStackLayout Grid.Column="3" Spacing="4" VerticalOptions="Center">
            <Label
                FontSize="16"
                Text="🔋"
                VerticalOptions="Center" />
            <Label
                x:Name="BatteryLabel"
                FontAttributes="Bold"
                FontSize="13"
                Text="%--"
                TextColor="White"
                VerticalOptions="Center" />
        </HorizontalStackLayout>

    </Grid>

</ContentView>
