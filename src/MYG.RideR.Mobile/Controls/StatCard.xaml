<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="MYG.RideR.Mobile.Controls.StatCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border
        x:Name="Root"
        Padding="10,8"
        BackgroundColor="{StaticResource PanelBackground}"
        Stroke="{StaticResource PanelStroke}"
        StrokeShape="RoundRectangle 14"
        StrokeThickness="1">

        <Grid ColumnDefinitions="32,*" ColumnSpacing="8">
            <Label
                FontSize="22"
                HorizontalOptions="Center"
                Text="{Binding Icon, Source={x:Reference Root}}"
                TextColor="{StaticResource NeonBlue}"
                VerticalOptions="Center" />
            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                <Label
                    FontAttributes="Bold"
                    FontSize="10"
                    Text="{Binding Title, Source={x:Reference Root}}"
                    TextColor="{StaticResource NeonBlue}" />
                <HorizontalStackLayout Spacing="4">
                    <Label
                        FontAttributes="Bold"
                        FontSize="22"
                        Text="{Binding Value, Source={x:Reference Root}}"
                        TextColor="White" />
                    <Label
                        FontSize="11"
                        Text="{Binding Unit, Source={x:Reference Root}}"
                        TextColor="{StaticResource TextSecondary}"
                        VerticalOptions="End" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </Border>

</ContentView>
