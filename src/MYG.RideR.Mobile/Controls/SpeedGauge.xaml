<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="MYG.RideR.Mobile.Controls.SpeedGauge"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid HeightRequest="420" WidthRequest="420">

        <!--  Dış halka  -->
        <Border
            BackgroundColor="#0A0F16"
            HeightRequest="420"
            Stroke="#2A2F38"
            StrokeShape="RoundRectangle 210"
            StrokeThickness="2"
            WidthRequest="420" />

        <!--  İç halka  -->
        <Border
            Margin="20"
            BackgroundColor="#05080C"
            Stroke="#10151C"
            StrokeShape="RoundRectangle 190"
            StrokeThickness="2" />

        <!--  Sol mavi yay  -->
        <BoxView
            Margin="22,70,0,70"
            HeightRequest="280"
            HorizontalOptions="Start"
            WidthRequest="8"
            Color="#00B7FF" />

        <!--  Sağ kırmızı yay  -->
        <BoxView
            Margin="0,70,22,70"
            HeightRequest="280"
            HorizontalOptions="End"
            WidthRequest="8"
            Color="#FF3B30" />

        <!--  Hız  -->
        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">

            <Label
                FontAttributes="Bold"
                FontSize="120"
                HorizontalOptions="Center"
                Text="{Binding SpeedKmh}"
                TextColor="White" />

            <Label
                FontSize="28"
                HorizontalOptions="Center"
                Text="km/h"
                TextColor="#8A8A8A" />

        </VerticalStackLayout>

    </Grid>

</ContentView>
