<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="MYG.RideR.Mobile.Controls.SpeedGauge"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid HeightRequest="340" WidthRequest="340">

        <GraphicsView x:Name="Canvas" />

        <VerticalStackLayout HorizontalOptions="Center" Spacing="0" VerticalOptions="Center">
            <Label
                x:Name="SpeedLabel"
                FontAttributes="Bold,Italic"
                FontSize="96"
                HorizontalOptions="Center"
                Text="0"
                TextColor="White" />
            <Label
                FontSize="18"
                HorizontalOptions="Center"
                Text="km/h"
                TextColor="{StaticResource GaugeUnitText}" />
        </VerticalStackLayout>

    </Grid>

</ContentView>
