<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="MYG.RideR.Mobile.Controls.SpeedGauge"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid HeightRequest="340" WidthRequest="340">

        <GraphicsView x:Name="Canvas" />

        <VerticalStackLayout HorizontalOptions="Center" Spacing="0" VerticalOptions="Center">
            <Label
                x:Name="SpeedLabel"
                FontAttributes="Bold,Italic"
                FontSize="96"
                HorizontalOptions="Center"
                Text="0"
                TextColor="White" />
            <Label
                FontSize="18"
                HorizontalOptions="Center"
                Text="km/h"
                TextColor="{StaticResource GaugeUnitText}" />
        </VerticalStackLayout>

        <Border
            Margin="0,0,0,18"
            Padding="16,6"
            BackgroundColor="{StaticResource PanelBackground}"
            HorizontalOptions="Center"
            Stroke="{StaticResource NeonBlue}"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="1.5"
            VerticalOptions="End">
            <HorizontalStackLayout Spacing="6">
                <Label
                    x:Name="GearLabel"
                    FontAttributes="Bold"
                    FontSize="22"
                    Text="-"
                    TextColor="White" />
                <Label
                    FontSize="12"
                    Text="VİTES"
                    TextColor="{StaticResource NeonBlue}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

    </Grid>

</ContentView>
